# Chạy `npm run setup` để tạo file .env với các khoá ngẫu nhiên.

# Neon PostgreSQL: pooled cho ứng dụng, direct cho Prisma Migrate.
# Thay các giá trị mẫu bằng URL từ Neon cùng một branch/database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Địa chỉ gốc của trang, dùng để tạo URL ghi vào thẻ NFC.
APP_URL="http://localhost:3000"

# Khoá tính hash của thẻ. KHÔNG ĐỔI sau khi đã ghi thẻ, đổi là mọi thẻ đã bán hỏng.
CARD_HASH_SECRET=""

# Khoá ký phiên xem 10 phút.
SCAN_TOKEN_SECRET=""

# Đăng nhập trang admin.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
